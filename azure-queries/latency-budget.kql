// Service Level Objective latency error budget report.
// Uses a fixed 30-day rolling window, consistent with error-budget.kql, since
// latency error budgets should be tracked over the same period as the Service Level Objective.
//
//   ./run-query.sh latency-budget.kql

// Define your latency Service Level Objective (e.g., p95 < 500ms)
let slo_p95_threshold = 1000; // milliseconds
let slo_target = 95.0; // 95% of requests should meet latency target
let timeRange = 30d;
// Formats a whole number with thousand separators (e.g. 3469361 -> "3,469,361") for readability,
let FormatWithCommas = (n: long) {
    let s = tostring(n);
    reverse(replace_regex(reverse(s), @"(\d{3})(?=\d)", @"\1,"))
};
// Calculate latency-based error budget
requests
| where cloud_RoleName == "hmpps-manage-people-on-probation-ui"
| where timestamp > ago(timeRange)
| summarize
    TotalRequests = count(),
    p50 = percentile(duration, 50),
    p95 = percentile(duration, 95),
    p99 = percentile(duration, 99),
    p999 = percentile(duration, 99.9),
    SlowRequests = countif(duration >= slo_p95_threshold)
| extend
    SlowRequestRate = (SlowRequests * 100.0) / TotalRequests,
    FastRequestRate = ((TotalRequests - SlowRequests) * 100.0) / TotalRequests,
    ErrorBudget = 100 - slo_target,
    ErrorBudgetRemaining = (100 - slo_target) - ((SlowRequests * 100.0) / TotalRequests),
    ErrorBudgetConsumedPct = ((SlowRequests * 100.0) / TotalRequests) / (100 - slo_target) * 100
| project
    Status = iff(ErrorBudgetRemaining < 0, "🔴 Breached", "✅ Within budget"),
    ErrorBudgetConsumed = strcat(tostring(round(ErrorBudgetConsumedPct, 2)), "%"),
    ErrorBudgetRemaining = strcat(tostring(round(ErrorBudgetRemaining, 2)), "%"),
    TotalRequests = FormatWithCommas(TotalRequests),
    SlowRequests = FormatWithCommas(SlowRequests),
    SlowRequestRate = strcat(tostring(round(SlowRequestRate, 2)), "%"),
    FastRequestRate = strcat(tostring(round(FastRequestRate, 2)), "%"),
    p50 = strcat(tostring(round(p50 / 1000.0, 2)), "s"),
    p95 = strcat(tostring(round(p95 / 1000.0, 2)), "s"),
    p99 = strcat(tostring(round(p99 / 1000.0, 2)), "s"),
    p999 = strcat(tostring(round(p999 / 1000.0, 2)), "s"),
    ServiceLevelObjectiveThreshold = strcat(tostring(round(slo_p95_threshold / 1000.0, 2)), "s"),
    ServiceLevelObjectiveTarget = strcat(tostring(slo_target), "%"),
    ErrorBudget = strcat(tostring(round(ErrorBudget, 2)), "%")
