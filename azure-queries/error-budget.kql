// Service Level Objective error budget report.
// Uses a fixed 30-day rolling window (rather than the 1d window used by the
// other scheduled reports) because error budgets are meant to track cumulative
// burn over the Service Level Objective period, not a single day's error rate.
//
//   ./run-query.sh error-budget.kql

// Define your Service Level Objective (e.g., 99.9% success rate = 0.1% error budget)
let slo = 99.9;
let timeRange = 30d;
let failureCodes = dynamic(["500", "400"]);
// Formats a whole number with thousand separators (e.g. 3469361 -> "3,469,361") for readability,
let FormatWithCommas = (n: long) {
    let s = tostring(n);
    trim_start(@",", reverse(replace_regex(reverse(s), @"(\d{3})", @"\1,")))
};
// Calculate error budget
requests
| where cloud_RoleName == "hmpps-manage-people-on-probation-ui"
| where timestamp > ago(timeRange)
| summarize
    TotalRequests = count(),
    FailedRequests = countif(resultCode in (failureCodes)), // adjust field name as needed
    SuccessRequests = countif(resultCode !in (failureCodes))
| extend
    ActualSuccessRate = (SuccessRequests * 100.0) / TotalRequests,
    ErrorRate = (FailedRequests * 100.0) / TotalRequests,
    ErrorBudget = 100 - slo,
    ErrorBudgetRemaining = (100 - slo) - ((FailedRequests * 100.0) / TotalRequests),
    ErrorBudgetConsumed = ((FailedRequests * 100.0) / TotalRequests) / (100 - slo) * 100
| project
    Status = iff(TotalRequests == 0, "⚪ No data", iff(ErrorBudgetRemaining < 0, "🔴 Breached", "✅ Within budget")),
    ErrorBudgetConsumed = strcat(tostring(round(ErrorBudgetConsumed, 2)), "%"),
    ErrorBudgetRemaining = strcat(tostring(round(ErrorBudgetRemaining, 2)), "%"),
    TotalRequests = FormatWithCommas(TotalRequests),
    FailedRequests = FormatWithCommas(FailedRequests),
    ActualSuccessRate = strcat(tostring(round(ActualSuccessRate, 2)), "%"),
    ErrorRate = strcat(tostring(round(ErrorRate, 2)), "%"),
    ServiceLevelObjective = strcat(tostring(slo), "%"),
    ErrorBudget = strcat(tostring(round(ErrorBudget, 2)), "%")
