{% from "mpop/components/pop-header/macro.njk" import popHeader %}
{% from "mpop/components/person-header/macro.njk" import personHeader %}
{%- from "moj/components/badge/macro.njk" import mojBadge -%}

{% set overallRisk = risksWidget.overallRisk %}
{% if overallRisk == 'VERY_HIGH' %}
    {% set overallRisk = 'VERY HIGH' %}
{% endif %}
{% set riskDataRosh = {
    assessments: [
        {
            rosh: {
                name: 'ROSH' if riskData
                    .assessments[0]
                    .rsr
                    .band else
                        'RISK OF SERIOUS HARM',
                        band: overallRisk
                }
        }
    ]
} %}
{% set riskBadges %}
{% if riskData
        .assessments[0]
        .combinedSeriousReoffendingPredictor
        .band != "NOT APPLICABLE" %}

{{ predictorBadge({
            data: riskData,
            predictor: 'combinedSeriousReoffendingPredictor',
            showScore: true
        })}}

{% if riskData
            .assessments[0]
            .rsr
            .band %}
{{ predictorBadge({
                data: riskData,
                predictor: 'rsr',
                showScore: true
            })}}
{% endif %}

{% if overallRisk and overallRisk !== 'NOT_FOUND' %}
{{ predictorBadge({
                data: riskDataRosh,
                predictor: 'rosh',
                showScore: false
            })}}
{% endif %}
{% endif %}


{% for group in riskBadgeData.groups %}
{% for risk in group.badges %}
<a
        href="/case/{{ headerCRN }}/risk/flag/{{ risk.id }}"
        class="risk-badge-link"
        data-qa="risk-badge-{{ risk.id }}"
>
    {{ mojBadge({
                    text: risk.text,
                    classes: risk.badgeClass
                }) }}
</a>
{% endfor %}
{% endfor %}

{% if riskBadgeData.remainingCount > 0 %}
<a
        href="/case/{{ headerCRN }}/risk"
        class="govuk-link risk-badge-more"
        data-qa="risk-badge-more"
>
    +{{ riskBadgeData.remainingCount }} active risk flags
</a>
{% endif %}
{% endset %}



{% if flags.enablePersonHeader %}
    {{ personHeader({
        name: headerPersonName.forename + ' ' + headerPersonName.surname,
        crn: headerCRN,
        dob: headerDob | dateWithYear,
        tier: (tierDetails.calculation.tierScore if flags.enablePersonHeaderTierV3 else tierCalculation.tierScore) | convertToTitleCase,
        historyHref: tierUrlV3 if flags.enablePersonHeaderTierV3 else headerTierLink,
        managedBy: managedBy.text,
        managedByHref: managedBy.href,
        riskBadges: riskBadges
    }) }}
{% else %}
    <div class="govuk-flex">
        <div>
            {% if flags.enableSupervisionPackagePoPHeader %}
                <div data-qa="new-pop-header">
                {{ popHeader({
                crn:headerCRN,
                dob: headerDob | dateWithYear,
                age: headerDob | yearsSince,
                tierScore: tierDetails.calculation.tierScore | convertToTitleCase,
                historyHref: tierUrlV3
            }) }}
                </div>
            {% else %}
                <ul data-qa="legacy-pop-header" class="govuk-list govuk-caption-m inline-list-from-tablet">
                    <li>CRN:
                        <span data-qa='crn'>{{ headerCRN }}</span>
                        <span class='govuk-!-padding-left-3 govuk-!-padding-right-3 hide-mobile'>|</span>
                    </li>
                    <li>Date of birth:
                        <span data-qa='headerDateOfBirthValue'>{{ headerDob | dateWithYear }}</span>
                        (<span data-qa='headerDateOfBirthAge'>{{ headerDob | yearsSince }} years old</span>)
                        <span class='govuk-!-padding-left-3 govuk-!-padding-right-3 hide-mobile'>|</span>
                    </li>
                    <li>
                        <a href="{{ headerTierLink }}" data-qa="tierLink" class="govuk-link">Tier: {{ tierCalculation.tierScore }}</a>
                    </li>
                </ul>
            {% endif %}
        </div>
    </div>
    <div class="moj-page-header-actions govuk-!-static-margin-bottom-4">
        <div class="moj-page-header-actions__title">
            <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">
                <span data-qa='name'>{{ headerPersonName.forename }}{{' '}}{{ headerPersonName.surname }}</span>
            </h1>
            <div class="pop-header-risk-badges">
                {{ riskBadges | safe }}
            </div>
        </div>
        <div class="pop-header-risk-flags">
            {{ personRiskFlags | safe }}
        </div>

        <div class="moj-page-header-actions__actions">
            {{ headerActions | safe }}
        </div>
    </div>
{% endif %}
