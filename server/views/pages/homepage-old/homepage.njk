{% extends "../../partials/layout.njk" %}
{% from "../../_components/govuk/accordion-mpop/macro.njk" import probationAccordion %}
{% from "probation/case-search/macro.njk" import caseSearch %}

{% set mainClasses = "app-container govuk-body" %}

{% set filter = "PAST_THREE_MONTHS" if flags.enable3MonthsOutcomes else "PAST_TWO_YEARS" %}

{% block header %}
  {% include "../../partials/prob_fe_header.njk" %}
  {% block banner %}{% endblock %}
  <div class="dps-header">
    <div class="govuk-width-container">
      <h1 class="govuk-heading-l" data-qa="pageHeading">Manage people on probation</h1>
    </div>
  </div>
  <div class="dps-homepage-search">
    <div class="govuk-width-container">
      {{ appSearch('/search', csrfToken) }}
    </div>
  </div>
{% endblock %}

{% set caseloadInfo %}
  <a class="govuk-link govuk-!-margin-left-2" href="/case" data-qa="formAnchorLink">
    55 Cases</a></br>
  <a class="govuk-link govuk-!-margin-left-2" href="/case" data-qa="formAnchorLink">
    15 Shared Cases</a></br>
  <a class="govuk-link govuk-!-margin-left-2" href="/case" data-qa="formAnchorLink">
    8 Cases with recent activity</a></br>
  <a class="govuk-link govuk-!-margin-left-2" href="/team/case" data-qa="formAnchorLink">
    10 Cases that you follow</a></br>
  <a class="govuk-link govuk-!-margin-left-2" href="/team/case" data-qa="formAnchorLink">
    120 Team cases</a></br>
{% endset %}

{% set appointmentsTable %}
  {% include './_appointments.njk' %}
{% endset %}

{% set outcomesTable %}
  {% include './_outcomes.njk' %}
{% endset %}

{% set myEnforcementActionsTable %}
  {% include './_myEnforcementActions.njk' %}
{% endset %}

{% block content %}
  {{ probationAccordion({
    id: "accordion-default",
    attributes: {
      'data-qa': 'homepage-appointments'
    },
    rememberExpanded: false,
    items: [
      {
        heading: {
        html: 'My caseload' + (' (' + totalOutcomes + ')' if outcomes.length else '')
      },
        afterHeading: {
        html: '<span class="govuk-accordion__section-heading visibility-hidden" aria-hidden="true">My upcoming appointments</span><a class="govuk-body govuk-link govuk-link--no-visited-state govuk-!-margin-bottom-0 govuk-!-margin-left-9" href="/case">View all cases</a>'  if appointments.length else ''
      },
        content: {
        html: caseloadInfo
      },
        expanded: true if appointments.length == 0 else false
      }
    ]
  }) }}

  {{ probationAccordion({
    id: "accordion-default",
    attributes: {
      'data-qa': 'homepage-appointments'
    },
    rememberExpanded: false,
    items: [
      {
        heading: {
        html: 'My upcoming appointments'
      },
        afterHeading: {
        html: '<span class="govuk-accordion__section-heading visibility-hidden" aria-hidden="true">My upcoming appointments</span><a class="govuk-body govuk-link govuk-link--no-visited-state govuk-!-margin-bottom-0 govuk-!-margin-left-9" href="/caseload/appointments/upcoming">View all upcoming appointments</a>'  if appointments.length else ''
      },
        content: {
        html: appointmentsTable
      },
        expanded: true if appointments.length == 0 else false
      }
    ]
  }) }}

  {{ probationAccordion({
    id: "accordion-default",
    attributes: {
      'data-qa': 'homepage-outcomes'
    },
    rememberExpanded: false,
    items: [
      {
        heading: {
        html: 'Outcomes to log' + (' (' + totalOutcomes + ')' if outcomes.length else '')
      },
        afterHeading: {
        html: '<span class="govuk-accordion__section-heading visibility-hidden" aria-hidden="true">Outcomes to log' + (' (' + totalOutcomes + ')' if outcomes.length else '') + ' </span>' +  ('<a class="govuk-body govuk-link govuk-link--no-visited-state govuk-!-margin-bottom-0 govuk-!-margin-left-9" href="/caseload/appointments/no-outcome?outcomeFilter=' + filter + '">Log more outcomes</a>' if outcomes.length else '')
      },
        content: {
        html: outcomesTable
      },
        expanded: true if outcomes.length == 0 else false
      }
    ]
  }) }}

  {{ probationAccordion({
    id: "accordion-default-enforcementAction-old",
    attributes: {
      'data-qa': 'homepage-enforcement-actions'
    },
    rememberExpanded: false,
    items: [
      {
        heading: {
        html: 'My enforcement actions'
      },
        afterHeading: {
        html: '<span class="govuk-accordion__section-heading visibility-hidden" aria-hidden="true">My enforcement actions</span><a class="govuk-body govuk-link govuk-link--no-visited-state govuk-!-margin-bottom-0 govuk-!-margin-left-9" href="/caseload/appointments/enforcement-actions">View all enforcement actions</a>'  if enforcementActions.length else ''
      },
        content: {
        html: myEnforcementActionsTable
      },
        expanded: true if enforcementActions.length == 0 else false
      }
    ]
  }) }}

  <hr class="govuk-section-break--l">

  {% include './_other-services.njk' %}
{% endblock %}
